# Copy to .env and fill in. Never commit .env.
# Small tier. SMALL_BACKEND=ollama uses SMALL_*; SMALL_BACKEND=cloud uses CLOUD_SMALL_*.
SMALL_BACKEND=ollama
SMALL_BASE_URL=http://127.0.0.1:11434/v1
SMALL_MODEL=qwen2.5:3b
SMALL_API_KEY=ollama
CLOUD_SMALL_BASE_URL=https://api.groq.com/openai/v1
CLOUD_SMALL_MODEL=openai/gpt-oss-20b
CLOUD_SMALL_API_KEY=
# Large tier (Groq), with Gemini as failover if Groq is down
LARGE_BASE_URL=https://api.groq.com/openai/v1
LARGE_MODEL=openai/gpt-oss-120b
LARGE_API_KEY=
LARGE_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LARGE_FALLBACK_MODEL=gemini-3.5-flash-lite
LARGE_FALLBACK_API_KEY=
# Eval quality judge (different model family from the large model)
JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
JUDGE_MODEL=gemini-3.5-flash-lite
JUDGE_API_KEY=
REQUEST_TIMEOUT_S=30
CACHE_SIM_THRESHOLD=0.92
CACHE_TTL_HOURS=24
ROUTER_HARD_THRESHOLD=0.5
ROUTER_UNSURE_BAND=0.15
# India grid emission factor (g CO2 per kWh) from the CEA CO2 Baseline Database. Note the version used.
GRID_EF_G_PER_KWH=
# Assumed CPU package power used to estimate cache/router overhead
CPU_ASSUMED_W=15
